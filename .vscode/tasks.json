{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Android: Build Debug",
      "type": "shell",
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "& { .\\tools\\android_env.ps1 > $null; if($LASTEXITCODE -ne 0){ exit $LASTEXITCODE }; .\\gradlew.bat assembleDebug }"
        ]
      },
      "linux": {
        "command": "./gradlew",
        "args": [
          "assembleDebug"
        ]
      },
      "osx": {
        "command": "./gradlew",
        "args": [
          "assembleDebug"
        ]
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Android: Install Debug",
      "type": "shell",
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "& { .\\tools\\android_env.ps1 > $null; if($LASTEXITCODE -ne 0){ exit $LASTEXITCODE }; .\\gradlew.bat installDebug }"
        ]
      },
      "linux": {
        "command": "./gradlew",
        "args": [
          "installDebug"
        ]
      },
      "osx": {
        "command": "./gradlew",
        "args": [
          "installDebug"
        ]
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Android: Launch App",
      "type": "shell",
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "& { $id = (& .\\tools\\android_env.ps1).Trim(); if(-not $id){ Write-Error 'applicationId missing'; exit 1 }; adb shell monkey -p $id 1 }"
        ]
      },
      "linux": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/tools/run_android_app.sh",
          "launch"
        ]
      },
      "osx": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/tools/run_android_app.sh",
          "launch"
        ]
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Android: Logcat (app only)",
      "type": "shell",
      "isBackground": true,
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          ".\\tools\\run_logcat_app.ps1"
        ]
      },
      "linux": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/tools/run_android_app.sh",
          "logcat"
        ]
      },
      "osx": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/tools/run_android_app.sh",
          "logcat"
        ]
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Android: Logcat to file",
      "type": "shell",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": [],
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          ".\\tools\\run_logcat_app.ps1",
          "-OutFile",
          "${workspaceFolder}\\logcat.txt"
        ]
      },
      "linux": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/tools/run_android_app.sh",
          "logcat",
          "${workspaceFolder}/logcat.txt"
        ]
      },
      "osx": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/tools/run_android_app.sh",
          "logcat",
          "${workspaceFolder}/logcat.txt"
        ]
      }
    },
    {
      "label": "Android: Stop App",
      "type": "shell",
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "& { $id = (& .\\tools\\android_env.ps1).Trim(); if(-not $id){ Write-Error 'applicationId missing'; exit 1 }; adb shell am force-stop $id }"
        ]
      },
      "linux": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/tools/run_android_app.sh",
          "stop"
        ]
      },
      "osx": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/tools/run_android_app.sh",
          "stop"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "Android: Full Run (install + launch + logcat)",
      "type": "shell",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Android: Build Debug",
        "Android: Install Debug",
        "Android: Launch App",
        "Android: Logcat (app only)"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
